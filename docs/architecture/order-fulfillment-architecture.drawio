<mxfile host="app.diagrams.net" type="device"><diagram id="order-fulfillment" name="Order Fulfillment Architecture"><mxGraphModel dx="1650" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style=&#x27;font-size:20px&#x27;&gt;NutraAxis · Order Fulfillment Integration Architecture (Conceptual)&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#6B7280&#x27;&gt;Event-driven routing of ACCS orders to fulfillment suppliers by the product &amp;#x27;fulfillment&amp;#x27; attribute · Draft 2026-10-09&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1200" height="55" as="geometry"/></mxCell><mxCell id="stage_105" value="SOURCE" style="text;html=1;align=center;fontStyle=1;fontColor=#6B7280;fontSize=11;" vertex="1" parent="1"><mxGeometry x="15" y="88" width="180" height="20" as="geometry"/></mxCell><mxCell id="stage_360" value="STAGE 1 · INBOUND" style="text;html=1;align=center;fontStyle=1;fontColor=#6B7280;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="88" width="180" height="20" as="geometry"/></mxCell><mxCell id="stage_695" value="STAGE 2 · TOPIC" style="text;html=1;align=center;fontStyle=1;fontColor=#6B7280;fontSize=11;" vertex="1" parent="1"><mxGeometry x="605" y="88" width="180" height="20" as="geometry"/></mxCell><mxCell id="stage_990" value="STAGE 3 · QUEUES" style="text;html=1;align=center;fontStyle=1;fontColor=#6B7280;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="88" width="180" height="20" as="geometry"/></mxCell><mxCell id="stage_1245" value="STAGE 4 · OUTBOUND" style="text;html=1;align=center;fontStyle=1;fontColor=#6B7280;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1155" y="88" width="180" height="20" as="geometry"/></mxCell><mxCell id="stage_1517" value="SUPPLIERS" style="text;html=1;align=center;fontStyle=1;fontColor=#6B7280;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1427" y="88" width="180" height="20" as="geometry"/></mxCell><mxCell id="sbns" value="Azure Service Bus · sb-forecast-tool (Standard)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#B7791F;strokeWidth=1.5;fontColor=#374151;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;dashed=1;dashPattern=8 5;fontStyle=1;fontSize=13;container=0;fontColor=#7C4A03;" vertex="1" parent="1"><mxGeometry x="530" y="130" width="570" height="480" as="geometry"/></mxCell><mxCell id="mon" value="Monitoring &amp; Alerting" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F7F0FC;strokeColor=#7B3FA0;strokeWidth=1.5;fontColor=#374151;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;dashed=1;dashPattern=8 5;fontStyle=1;fontSize=13;container=0;fontColor=#5B2C83;" vertex="1" parent="1"><mxGeometry x="20" y="725" width="1605" height="205" as="geometry"/></mxCell><mxCell id="accs" value="&lt;b&gt;Adobe Commerce (ACCS)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Order source (storefront)&lt;br&gt;Adobe I/O Events webhook&lt;br&gt;REST API: product attrs&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#4B5563;strokeWidth=1.5;fontColor=#374151;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="170" height="150" as="geometry"/></mxCell><mxCell id="inbound" value="&lt;b&gt;Stage 1 · Inbound Adapter&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Azure Function · HTTP trigger&lt;br&gt;accs-order-webhook&lt;br&gt;&lt;br&gt;• Validate ACCS signature&lt;br&gt;• Idempotency check (orderId)&lt;br&gt;• Enrich SKU → fulfillment&lt;br&gt;• Map → Canonical Order&lt;br&gt;• Split items by supplier&lt;br&gt;• Publish 1 msg / supplier&lt;br&gt;• Write OrderFulfillmentLog&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#374151;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="250" y="220" width="220" height="290" as="geometry"/></mxCell><mxCell id="sql" value="&lt;b&gt;Azure SQL&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;OrderFulfillmentLog&lt;br&gt;Idempotency + audit trail&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EEF7EE;strokeColor=#2E7D32;strokeWidth=1.5;fontColor=#374151;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="250" y="560" width="200" height="90" as="geometry"/></mxCell><mxCell id="topic" value="&lt;b&gt;Stage 2 · Topic: orders.canonical&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;App property: supplier&lt;br&gt;Duplicate detection 24h · TTL 7d&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B7791F;strokeWidth=1.5;fontColor=#374151;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="550" y="175" width="290" height="85" as="geometry"/></mxCell><mxCell id="sub_nl" value="&lt;b&gt;sub-nutralogics&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;SQL filter: supplier = &amp;#x27;nutralogics&amp;#x27;&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B7791F;strokeWidth=1.5;fontColor=#374151;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="600" y="300" width="230" height="62" as="geometry"/></mxCell><mxCell id="sub_cc" value="&lt;b&gt;sub-cartcom&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;SQL filter: supplier = &amp;#x27;cartcom&amp;#x27;&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B7791F;strokeWidth=1.5;fontColor=#374151;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="600" y="400" width="230" height="62" as="geometry"/></mxCell><mxCell id="sub_mtl" value="&lt;b&gt;sub-mtl&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;SQL filter: supplier = &amp;#x27;mtl&amp;#x27;&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B7791F;strokeWidth=1.5;fontColor=#374151;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="600" y="500" width="230" height="62" as="geometry"/></mxCell><mxCell id="q_nl" value="&lt;b&gt;Stage 3 · to-nutralogics&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Max delivery 3 → DLQ&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B7791F;strokeWidth=1.5;fontColor=#374151;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="900" y="300" width="180" height="62" as="geometry"/></mxCell><mxCell id="q_cc" value="&lt;b&gt;Stage 3 · to-cartcom&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Max delivery 3 → DLQ&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B7791F;strokeWidth=1.5;fontColor=#374151;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="900" y="400" width="180" height="62" as="geometry"/></mxCell><mxCell id="q_mtl" value="&lt;b&gt;Stage 3 · to-mtl&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Max delivery 3 → DLQ&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B7791F;strokeWidth=1.5;fontColor=#374151;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="900" y="500" width="180" height="62" as="geometry"/></mxCell><mxCell id="ad_nl" value="&lt;b&gt;fulfillment-nutralogics&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Function · SB queue trigger&lt;br&gt;Map canonical → NL format&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#374151;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1140" y="296" width="210" height="70" as="geometry"/></mxCell><mxCell id="ad_cc" value="&lt;b&gt;fulfillment-cartcom&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Function · SB queue trigger&lt;br&gt;Map canonical → Jazz format&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#374151;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1140" y="396" width="210" height="70" as="geometry"/></mxCell><mxCell id="ad_mtl" value="&lt;b&gt;fulfillment-mtl&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Function · SB queue trigger&lt;br&gt;Map canonical → MTL format&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#374151;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1140" y="496" width="210" height="70" as="geometry"/></mxCell><mxCell id="sup_nl" value="&lt;b&gt;NutraLogics&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;fulfillment = CPPC&lt;br&gt;API TBD · Phase 1: email stub&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#4B5563;strokeWidth=1.5;fontColor=#374151;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1410" y="296" width="215" height="70" as="geometry"/></mxCell><mxCell id="sup_cc" value="&lt;b&gt;Cart.com (Jazz)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;fulfillment = Cart&lt;br&gt;Jazz API (ASN creds) · email stub&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#4B5563;strokeWidth=1.5;fontColor=#374151;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1410" y="396" width="215" height="70" as="geometry"/></mxCell><mxCell id="sup_mtl" value="&lt;b&gt;MTL&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;fulfillment = MTL&lt;br&gt;API TBD · Phase 1: email stub&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#4B5563;strokeWidth=1.5;fontColor=#374151;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1410" y="496" width="215" height="70" as="geometry"/></mxCell><mxCell id="appi" value="&lt;b&gt;Application Insights&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;appi-forecast-tool&lt;br&gt;Requests · exceptions · dependencies&lt;br&gt;Custom events: order.received,&lt;br&gt;order.published, order.delivered&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B3FA0;strokeWidth=1.5;fontColor=#374151;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="45" y="770" width="330" height="135" as="geometry"/></mxCell><mxCell id="smart" value="&lt;b&gt;Smart Detection&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Failure anomalies&lt;br&gt;Performance degradation&lt;br&gt;Memory leak · security&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B3FA0;strokeWidth=1.5;fontColor=#374151;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="415" y="770" width="260" height="135" as="geometry"/></mxCell><mxCel